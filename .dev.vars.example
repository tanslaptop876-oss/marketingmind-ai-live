# Copy to .dev.vars for local Cloudflare Pages Functions development.
# Never commit the real .dev.vars file.

ENVIRONMENT=development

# Supabase public project configuration. Keep service-role keys server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-secret
MARKETINGMIND_WORKSPACE_ID=00000000-0000-4000-8000-000000000000

# Public lead capture. Use comma-separated exact origins when needed.
LEAD_FORM_ORIGIN=https://your-business.example
TURNSTILE_SITE_KEY=replace-with-public-site-key
TURNSTILE_SECRET_KEY=replace-with-server-secret

# Safe public form copy returned by /api/form-config.
FORM_BUSINESS_NAME=Studio Salvador Salon & Holistic Health Spa
FORM_BUSINESS_CATEGORY=Salon & Spa
FORM_BUSINESS_PHONE=+91 89108 48092
FORM_TITLE=Book a consultation
FORM_INTRO=Tell us what you are looking for and our team will contact you to confirm a convenient time.
FORM_SERVICES=Haircut,Hair colour,Hair spa,Bridal package,Skin care,Spa ritual
FORM_BUTTON_LABEL=Request appointment
FORM_SUCCESS_MESSAGE=Thank you — our team will contact you shortly.

# Server-side AI provider key.
OPENAI_API_KEY=replace-with-server-secret
OPENAI_MODEL=gpt-5.4-mini

# Google OAuth application and GA4 property.
GOOGLE_CLIENT_ID=replace-with-client-id
GOOGLE_CLIENT_SECRET=replace-with-client-secret
GA4_PROPERTY_ID=123456789

# Meta application OAuth configuration.
META_APP_ID=replace-with-app-id
META_APP_SECRET=replace-with-app-secret
META_REDIRECT_URI=https://marketingmind-ai-live.pages.dev/api/meta-callback
# Keep disabled until Meta app review and encrypted token storage are complete.
META_CONNECT_ENABLED=false
META_GRAPH_VERSION=v23.0
# Generate at least 32 random characters and store only as an encrypted Cloudflare secret.
META_TOKEN_ENCRYPTION_KEY=replace-with-long-random-secret
